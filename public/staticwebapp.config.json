{
    "routes": [
        {
            "route": "/registration",
            "rewrite": "/registration.html"
        },
        {
            "route": "/schedule",
            "rewrite": "/schedule.html"
        },
        {
            "route": "/equipment",
            "rewrite": "/equipment.html"
        },
        {
            "route": "/area-teams",
            "rewrite": "/area-teams.html"
        },
        {
            "route": "/contact",
            "rewrite": "/contact.html"
        },
        {
            "route": "/registration/",
            "redirect": "/registration",
            "statusCode": 301
        },
        {
            "route": "/schedule/",
            "redirect": "/schedule",
            "statusCode": 301
        },
        {
            "route": "/equipment/",
            "redirect": "/equipment",
            "statusCode": 301
        },
        {
            "route": "/area-teams/",
            "redirect": "/area-teams",
            "statusCode": 301
        },
        {
            "route": "/contact/",
            "redirect": "/contact",
            "statusCode": 301
        }
    ],
    "responseOverrides": {
        "404": {
            "rewrite": "/404.html",
            "statusCode": 404
        }
    },
    "mimeTypes": {
        ".json": "text/json"
    }
}
